---
import { getCollection } from 'astro:content';
import { site_config } from '../../site.config';

const mau_luan_phien = ['--mau-phu-1', '--mau-phu-2', '--mau-phu-3'];
const san_pham = await getCollection('products');

function dinh_dang_gia(gia: number, don_vi: string) {
  if (don_vi === 'VND') {
    return gia.toLocaleString('vi-VN') + ' đ';
  }
  return `${gia.toLocaleString('vi-VN')} ${don_vi}`;
}
---

<section class="mo-dau">
  <span class="huy-hieu">🛍️ Cửa hàng</span>
  <h1>{site_config.ten_hien_thi}</h1>
  <p class="chu-mo">{site_config.loi_chao}</p>
</section>

<section class="luoi-san-pham">
  {san_pham.map((sp, i) => (
    <div class="the-san-pham khoi-phu">
      <div class="khung-anh" style={`background:var(${mau_luan_phien[i % 3]})`}>
        <img src={sp.data.anh} alt={sp.data.ten_san_pham} />
      </div>
      <div class="noi-dung-the">
        <h3>{sp.data.ten_san_pham}</h3>
        <p class="gia">{dinh_dang_gia(sp.data.gia, sp.data.don_vi_tien)}</p>
      </div>
    </div>
  ))}
  {san_pham.length === 0 && <p class="chu-mo">Chưa có sản phẩm nào.</p>}
</section>

<style>
  .mo-dau {
    padding: var(--khoang-cach-lon) 0 var(--khoang-cach-vua);
    text-align: center;
  }
  .mo-dau h1 {
    font-size: 2.4rem;
    margin: 0.6rem 0 0.5rem;
  }
  .luoi-san-pham {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--khoang-cach-vua);
    padding-bottom: var(--khoang-cach-lon);
  }
  .the-san-pham {
    overflow: hidden;
  }
  .khung-anh {
    aspect-ratio: 1 / 1;
    border-radius: var(--do-bo-goc) var(--do-bo-goc) 0 0;
    overflow: hidden;
    display: flex;
  }
  .khung-anh img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .noi-dung-the {
    padding: var(--khoang-cach-vua);
  }
  .noi-dung-the h3 {
    margin: 0 0 0.3rem;
    font-size: 1rem;
  }
  .gia {
    margin: 0;
    font-weight: 800;
    color: var(--mau-nhan-manh);
  }
</style>
