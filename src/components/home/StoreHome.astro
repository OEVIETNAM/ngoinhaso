---
import { getCollection } from 'astro:content';
import { site_config } from '../../site.config';

const san_pham = await getCollection('products');

function dinh_dang_gia(gia: number, don_vi: string) {
  if (don_vi === 'VND') {
    return gia.toLocaleString('vi-VN') + ' đ';
  }
  return `${gia.toLocaleString('vi-VN')} ${don_vi}`;
}
---

<section class="mo-dau">
  <p class="nhan-kicker">Cửa hàng</p>
  <h1>{site_config.ten_hien_thi}</h1>
  <p class="chu-mo">{site_config.loi_chao}</p>
</section>

<section class="luoi-san-pham">
  {san_pham.map((sp) => (
    <div class="o-san-pham">
      <img src={sp.data.anh} alt={sp.data.ten_san_pham} />
      <h3>{sp.data.ten_san_pham}</h3>
      <p class="gia">{dinh_dang_gia(sp.data.gia, sp.data.don_vi_tien)}</p>
    </div>
  ))}
  {san_pham.length === 0 && <p class="chu-mo">Chưa có sản phẩm nào.</p>}
</section>

<style>
  .mo-dau {
    padding: var(--khoang-cach-lon) 0 var(--khoang-cach-vua);
  }
  .mo-dau h1 {
    font-size: 2rem;
    margin: 0.4rem 0 0.5rem;
  }
  .luoi-san-pham {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--khoang-cach-lon) var(--khoang-cach-vua);
    padding-bottom: var(--khoang-cach-lon);
  }
  .o-san-pham img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    margin-bottom: var(--khoang-cach-nho);
  }
  .o-san-pham h3 {
    margin: 0 0 0.2rem;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .gia {
    margin: 0;
    font-size: 0.9rem;
    color: var(--mau-chu-nhan);
  }
  @media (max-width: 640px) {
    .luoi-san-pham { grid-template-columns: repeat(2, 1fr); }
  }
</style>
