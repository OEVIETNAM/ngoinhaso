---
import { getCollection } from 'astro:content';
import { site_config } from '../../site.config';

const bai_viet = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const [bai_noi_bat, ...bai_con_lai] = bai_viet;
---

<section class="mo-dau">
  <p class="nhan-chuyen-muc">{site_config.mo_ta_ngan}</p>
  <h1>{site_config.ten_hien_thi}</h1>
  <p class="chu-mo loi-chao">{site_config.loi_chao}</p>
</section>

{bai_noi_bat && (
  <a class="bai-noi-bat" href={`/blog/${bai_noi_bat.slug}`}>
    {bai_noi_bat.data.cover && <img src={bai_noi_bat.data.cover} alt={bai_noi_bat.data.title} />}
    <div class="noi-dung-noi-bat">
      <span class="nhan-chuyen-muc">Bài mới nhất</span>
      <h2>{bai_noi_bat.data.title}</h2>
      <p class="chu-mo">{new Date(bai_noi_bat.data.date).toLocaleDateString('vi-VN')}</p>
    </div>
  </a>
)}

<section class="luoi-bao">
  {bai_con_lai.map((bai) => (
    <a class="the-bai khoi-phu" href={`/blog/${bai.slug}`}>
      <h3>{bai.data.title}</h3>
      <p class="chu-mo">
        {new Date(bai.data.date).toLocaleDateString('vi-VN')}
        {bai.data.tags.length > 0 && ` — ${bai.data.tags.join(', ')}`}
      </p>
    </a>
  ))}
  {bai_viet.length === 0 && <p class="chu-mo">Chưa có bài viết nào.</p>}
</section>

<style>
  .mo-dau {
    padding: var(--khoang-cach-lon) 0 var(--khoang-cach-vua);
    border-bottom: 1px solid var(--mau-vien);
  }
  .nhan-chuyen-muc {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: var(--mau-nhan-manh);
    font-weight: 700;
  }
  .mo-dau h1 {
    font-size: 2.75rem;
    margin: 0.4rem 0;
  }
  .loi-chao {
    max-width: 640px;
  }
  .bai-noi-bat {
    display: block;
    text-decoration: none;
    color: var(--mau-chu);
    padding: var(--khoang-cach-vua) 0;
    border-bottom: 1px solid var(--mau-vien);
  }
  .bai-noi-bat img {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }
  .noi-dung-noi-bat {
    padding-top: var(--khoang-cach-nho);
  }
  .noi-dung-noi-bat h2 {
    font-size: 2rem;
    margin: 0.3rem 0;
  }
  .luoi-bao {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--khoang-cach-vua);
    padding: var(--khoang-cach-vua) 0 var(--khoang-cach-lon);
  }
  .the-bai {
    text-decoration: none;
    color: var(--mau-chu);
    padding-top: var(--khoang-cach-nho);
  }
  .the-bai h3 {
    font-size: 1.15rem;
    margin: 0 0 0.3rem;
  }
  @media (max-width: 760px) {
    .luoi-bao { grid-template-columns: 1fr; }
  }
</style>
