---
import { getCollection } from 'astro:content';
import { duong_dan } from '../../lib/duong_dan';
import { site_config } from '../../site.config';

const mau_luan_phien = ['--mau-phu-1', '--mau-phu-2', '--mau-phu-3'];
const bai_viet = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<section class="mo-dau">
  <span class="huy-hieu">👋 Xin chào</span>
  <h1>{site_config.ten_hien_thi}</h1>
  <p class="chu-mo">{site_config.loi_chao}</p>
</section>

<section class="luoi-bai">
  {bai_viet.map((bai, i) => (
    <a class="the-bai khoi-phu" href={duong_dan(`blog/${bai.slug}`)}>
      <div class="khung-anh" style={`background:var(${mau_luan_phien[i % 3]})`}>
        {bai.data.cover && <img src={bai.data.cover} alt={bai.data.title} />}
      </div>
      <div class="noi-dung-the">
        <h3>{bai.data.title}</h3>
        <p class="chu-mo">{new Date(bai.data.date).toLocaleDateString('vi-VN')}</p>
        {bai.data.tags.length > 0 && (
          <div class="hang-nhan">
            {bai.data.tags.map((t) => <span class="nhan">{t}</span>)}
          </div>
        )}
      </div>
    </a>
  ))}
  {bai_viet.length === 0 && <p class="chu-mo">Chưa có bài viết nào.</p>}
</section>

<style>
  .mo-dau {
    padding: var(--khoang-cach-lon) 0 var(--khoang-cach-vua);
    text-align: center;
  }
  .mo-dau h1 {
    font-size: 2.4rem;
    margin: 0.6rem 0 0.5rem;
  }
  .luoi-bai {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--khoang-cach-vua);
    padding-bottom: var(--khoang-cach-lon);
  }
  .the-bai {
    display: block;
    overflow: hidden;
    text-decoration: none;
    color: var(--mau-chu);
  }
  .khung-anh {
    aspect-ratio: 16 / 10;
    border-radius: var(--do-bo-goc) var(--do-bo-goc) 0 0;
    overflow: hidden;
    display: flex;
  }
  .khung-anh img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .noi-dung-the {
    padding: var(--khoang-cach-vua);
  }
  .noi-dung-the h3 {
    margin: 0 0 0.3rem;
    font-size: 1.2rem;
  }
  .hang-nhan {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.6rem;
  }
  .nhan {
    background: var(--mau-vien);
    color: var(--mau-chu);
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
</style>
