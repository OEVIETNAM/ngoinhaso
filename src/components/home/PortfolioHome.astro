---
import { getCollection } from 'astro:content';
import { site_config } from '../../site.config';

const du_an = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const so_du_an = du_an.length;
const tat_ca_the = [...new Set(du_an.flatMap((d) => d.data.tags))];
---

<section class="mo-dau">
  <span class="nhan-huy-hieu">Portfolio</span>
  <h1>{site_config.ten_hien_thi}</h1>
  <p class="chu-mo mo-ta-lon">{site_config.loi_chao}</p>

  <div class="hang-so-lieu">
    <div class="so-lieu">
      <strong>{so_du_an}</strong>
      <span class="chu-mo">dự án</span>
    </div>
    {tat_ca_the.length > 0 && (
      <div class="so-lieu">
        <strong>{tat_ca_the.length}</strong>
        <span class="chu-mo">lĩnh vực</span>
      </div>
    )}
  </div>
</section>

<section class="phan-du-an">
  <div class="tieu-de-phan">
    <h2>Dự án nổi bật</h2>
    <p class="chu-mo">Một số công việc gần đây</p>
  </div>

  <div class="luoi-du-an">
    {du_an.map((bai) => (
      <a class="the-du-an khoi-phu" href={`/blog/${bai.slug}`}>
        {bai.data.cover && (
          <div class="khung-anh">
            <img src={bai.data.cover} alt={bai.data.title} />
          </div>
        )}
        <div class="noi-dung-the">
          <h3>{bai.data.title}</h3>
          {bai.data.tags.length > 0 && (
            <div class="hang-the-phu">
              {bai.data.tags.slice(0, 3).map((t) => <span class="the-phu">{t}</span>)}
            </div>
          )}
          <span class="lien-ket-xem">Xem chi tiết →</span>
        </div>
      </a>
    ))}
    {du_an.length === 0 && <p class="chu-mo">Chưa có dự án nào được đăng.</p>}
  </div>
</section>

<style>
  .mo-dau {
    padding: var(--khoang-cach-lon) 0 var(--khoang-cach-vua);
    text-align: center;
  }
  .mo-dau h1 {
    font-size: 2.75rem;
    margin: 0.75rem 0 0.5rem;
  }
  .mo-ta-lon {
    max-width: 560px;
    margin: 0 auto;
    font-size: 1.1rem;
  }
  .hang-so-lieu {
    display: flex;
    justify-content: center;
    gap: var(--khoang-cach-lon);
    margin-top: var(--khoang-cach-vua);
  }
  .so-lieu {
    display: flex;
    flex-direction: column;
  }
  .so-lieu strong {
    font-family: var(--font-mac-dinh-tieu-de);
    font-size: 1.75rem;
    color: var(--mau-nhan-manh);
  }
  .so-lieu span {
    font-size: 0.85rem;
  }
  .phan-du-an {
    padding: var(--khoang-cach-vua) 0 var(--khoang-cach-lon);
  }
  .tieu-de-phan {
    margin-bottom: var(--khoang-cach-vua);
  }
  .tieu-de-phan h2 {
    margin: 0 0 0.2rem;
    font-size: 1.6rem;
  }
  .luoi-du-an {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--khoang-cach-vua);
  }
  .the-du-an {
    display: block;
    overflow: hidden;
    text-decoration: none;
    color: var(--mau-chu);
  }
  .khung-anh {
    overflow: hidden;
    border-radius: var(--do-bo-goc) var(--do-bo-goc) 0 0;
  }
  .khung-anh img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .the-du-an:hover .khung-anh img {
    transform: scale(1.05);
  }
  .noi-dung-the {
    padding: var(--khoang-cach-vua);
  }
  .noi-dung-the h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }
  .hang-the-phu {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }
  .the-phu {
    font-size: 0.72rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--mau-nen);
    color: var(--mau-chu-nhan);
    border: 1px solid var(--mau-vien);
  }
  .lien-ket-xem {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--mau-nhan-manh);
  }
</style>
