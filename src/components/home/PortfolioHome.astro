---
import { getCollection } from 'astro:content';
import { site_config } from '../../site.config';

const mau_luan_phien = ['--mau-phu-1', '--mau-phu-2', '--mau-phu-3'];
const du_an = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<section class="mo-dau">
  <span class="huy-hieu">✨ Portfolio</span>
  <h1>{site_config.ten_hien_thi}</h1>
  <p class="chu-mo">{site_config.loi_chao}</p>
</section>

<section class="luoi-du-an">
  {du_an.map((bai, i) => (
    <a class="the-du-an khoi-phu" href={`/blog/${bai.slug}`}>
      <div class="khung-anh" style={`background:var(${mau_luan_phien[i % 3]})`}>
        {bai.data.cover && <img src={bai.data.cover} alt={bai.data.title} />}
      </div>
      <div class="noi-dung-the">
        <h3>{bai.data.title}</h3>
      </div>
    </a>
  ))}
  {du_an.length === 0 && <p class="chu-mo">Chưa có dự án nào.</p>}
</section>

<style>
  .mo-dau {
    padding: var(--khoang-cach-lon) 0 var(--khoang-cach-vua);
    text-align: center;
  }
  .mo-dau h1 {
    font-size: 2.4rem;
    margin: 0.6rem 0 0.5rem;
  }
  .luoi-du-an {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--khoang-cach-vua);
    padding-bottom: var(--khoang-cach-lon);
  }
  .the-du-an {
    display: block;
    overflow: hidden;
    text-decoration: none;
    color: var(--mau-chu);
  }
  .khung-anh {
    aspect-ratio: 4 / 3;
    border-radius: var(--do-bo-goc) var(--do-bo-goc) 0 0;
    overflow: hidden;
    display: flex;
  }
  .khung-anh img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .noi-dung-the {
    padding: var(--khoang-cach-vua);
  }
  .noi-dung-the h3 {
    margin: 0;
    font-size: 1.1rem;
  }
</style>
