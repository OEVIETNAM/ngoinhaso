---
import { getCollection } from 'astro:content';
import { duong_dan } from '../../lib/duong_dan';
import { site_config } from '../../site.config';

const du_an = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<section class="mo-dau">
  <h1 class="tieu-de-sang">{site_config.ten_hien_thi}</h1>
  <p class="chu-mo">{site_config.loi_chao}</p>
</section>

<section class="luoi-du-an">
  {du_an.map((bai) => (
    <a class="the-du-an khoi-phu" href={duong_dan(`blog/${bai.slug}`)}>
      {bai.data.cover && (
        <div class="khung-anh">
          <img src={bai.data.cover} alt={bai.data.title} />
        </div>
      )}
      <div class="noi-dung-the">
        <h3>{bai.data.title}</h3>
      </div>
    </a>
  ))}
  {du_an.length === 0 && <p class="chu-mo">Chưa có dự án nào.</p>}
</section>

<style>
  .mo-dau {
    padding: var(--khoang-cach-lon) 0;
  }
  .mo-dau h1 {
    font-size: 2.5rem;
  }
  .luoi-du-an {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--khoang-cach-vua);
    padding-bottom: var(--khoang-cach-lon);
  }
  .the-du-an {
    display: block;
    overflow: hidden;
    text-decoration: none;
    color: var(--mau-chu);
  }
  .khung-anh {
    overflow: hidden;
    border-radius: var(--do-bo-goc) var(--do-bo-goc) 0 0;
  }
  .khung-anh img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    filter: brightness(0.85) saturate(1.1);
    transition: filter 0.2s ease, transform 0.3s ease;
  }
  .the-du-an:hover .khung-anh img {
    filter: brightness(1) saturate(1.2);
    transform: scale(1.04);
  }
  .noi-dung-the {
    padding: var(--khoang-cach-nho) var(--khoang-cach-vua);
  }
  .noi-dung-the h3 {
    margin: 0;
    font-size: 1rem;
  }
</style>
