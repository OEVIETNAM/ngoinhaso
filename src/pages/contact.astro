---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site_config } from '../site.config';

const { lien_he } = site_config;
const co_du_lieu_lien_he =
  lien_he.email || lien_he.dien_thoai || (lien_he.mang_xa_hoi && lien_he.mang_xa_hoi.length > 0);
---

<BaseLayout tieu_de="Liên hệ">
  <article class="trang-don">
    <h1>Liên hệ</h1>
    {co_du_lieu_lien_he ? (
      <ul class="danh-sach-lien-he">
        {lien_he.email && (
          <li>Email: <a href={`mailto:${lien_he.email}`}>{lien_he.email}</a></li>
        )}
        {lien_he.dien_thoai && <li>Điện thoại: {lien_he.dien_thoai}</li>}
        {lien_he.mang_xa_hoi?.map((mang) => (
          <li>{mang.ten}: <a href={mang.duong_dan} target="_blank" rel="noopener noreferrer">{mang.duong_dan}</a></li>
        ))}
      </ul>
    ) : (
      <p class="chu-mo">Chưa có thông tin liên hệ.</p>
    )}
  </article>
</BaseLayout>

<style>
  .trang-don {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--khoang-cach-lon) 0;
  }
  .danh-sach-lien-he {
    list-style: none;
    padding: 0;
  }
  .danh-sach-lien-he li {
    margin-bottom: var(--khoang-cach-nho);
  }
</style>
